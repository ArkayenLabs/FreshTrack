<resources>
    <!--
      The brand lives here and nowhere else. It was previously hardcoded in a
      dozen screens, notifications and export filenames, which is why the name
      drifted out of sync with the store listing in the first place.
    -->
    <string name="app_name">GoodBefore</string>

    <!--
      Deliberately not "AI Expiry Tracker and Food Saver". That is the store
      positioning; the AI capabilities it refers to are not built, and the app
      should not claim them from its own launch screen.
    -->
    <string name="app_tagline">Know what to use first.</string>

    <string name="app_logo_description">GoodBefore logo</string>
