    <!--
      Today.

      The headlines are plurals rather than a formatted count with an "s" tacked
      on, because "1 foods" is wrong in English and the rule is different again
      in most other languages. Getting this right in the resource is the whole
      reason for having one.
    -->
    <plurals name="today_headline_overdue">
        <item quantity="one">One food is past its date</item>
        <item quantity="other">%1$d foods are past their date</item>
    </plurals>
    <plurals name="today_headline_due_today">
        <item quantity="one">One food is worth using today</item>
        <item quantity="other">%1$d foods are worth using today</item>
    </plurals>
    <plurals name="today_headline_this_week">
        <item quantity="one">One food to use this week</item>
