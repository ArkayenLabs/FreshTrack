{
  "name": "freshtrack-firestore-rules",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Security rules tests for FreshTrack's Firestore backend. Not part of the Android build.",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-freshtrack \"node --test firestore-tests/rules.test.mjs\"",
    "test:sync-e2e": "firebase emulators:exec --only firestore,auth --project demo-freshtrack \"./gradlew :app:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.example.freshtrack.data.sync.SyncEndToEndTest\"",
    "test:sync-e2e:win": "firebase emulators:exec --only firestore,auth --project demo-freshtrack \".\\gradlew.bat :app:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.example.freshtrack.data.sync.SyncEndToEndTest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.2.0"
  }
}
