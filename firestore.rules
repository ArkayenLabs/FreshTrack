rules_version = '2';

// GoodBefore Firestore security rules.
//
// Deny by default: anything not matched below is refused. Every rule assumes a
// hostile client, because the client is a published app that anyone can
// decompile and drive with arbitrary requests.
//
// Shape:
//   /users/{uid}                        profile, entitlement, kitchen ids
//   /kitchens/{kitchenId}               memberUids is the access-control list
//   /kitchens/{kitchenId}/items/{id}    the inventory itself
//   /kitchens/{kitchenId}/events/{id}   the append-only ledger
//
// Note on queries: there is no `list` permission on /kitchens anywhere below.
// Rules cannot reliably constrain what a collection query returns, so the client
// never queries the collection — it reads its own user document, takes the
// kitchen ids, and fetches each kitchen by id. That removes a whole class of
// "accidentally readable by everyone" mistakes.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Membership lookup for subcollections. Costs one document read per rule
    // evaluation, which is the price of shared kitchens.
    function kitchenData(kitchenId) {
      return get(/databases/$(database)/documents/kitchens/$(kitchenId)).data;
    }

    function isMemberOf(kitchenId) {
      return isSignedIn() && uid() in kitchenData(kitchenId).memberUids;
    }

    function isOwnerOf(kitchenId) {
      return isSignedIn() && kitchenData(kitchenId).ownerUid == uid();
    }

    // Entitlement lives on the kitchen, not the owner's user document, because
    // the rules already fetch the kitchen — checking the owner's profile instead
    // would cost a second billed read on every item write. A Cloud Function
    // sets this when a Play Billing purchase is verified; clients cannot.
    function kitchenIsPremium(kitchenId) {
      return kitchenData(kitchenId).get('isPremium', false) == true;
    }

    // Household size. Free kitchens are single-user; premium allows a household.
    function memberLimitFor(isPremium) {
      return isPremium ? 6 : 1;
    }

    // The sync cursor. Devices' clocks are not comparable with each other, so
    // ordering across devices is settled by the server's clock instead: every
    // write must carry serverUpdatedAt equal to the time the server accepted
    // it, which a client can only produce with FieldValue.serverTimestamp().
    // A client-supplied value is refused, so no device can back-date a write
    // past another device's cursor.
    function stampedByServer() {
      return request.resource.data.serverUpdatedAt == request.time;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    //
    // `plan` is an entitlement. It must only ever be written by a trusted server
    // (a Cloud Function that has verified a Play Billing purchase). A client that
    // could set its own plan could grant itself premium for free, so both create
    // and update refuse any client-supplied change to it.
    match /users/{userId} {
      allow get: if isSignedIn() && uid() == userId;

      allow create: if isSignedIn()
                    && uid() == userId
                    && !('plan' in request.resource.data);

      allow update: if isSignedIn()
                    && uid() == userId
                    && request.resource.data.get('plan', 'free')
                       == resource.data.get('plan', 'free');

      // A user may delete their own profile as part of deleting their account.
      // Google Play requires an account deletion path, and without Cloud
      // Functions there is no trusted server to do it on their behalf.
      allow delete: if isSignedIn() && uid() == userId;
    }

    // ─── Kitchens ───────────────────────────────────────────────────────────
    match /kitchens/{kitchenId} {

      // Read the kitchen document directly from `resource`, rather than calling
      // isMemberOf(), to avoid paying for a second read of the same document.
      allow get: if isSignedIn() && uid() in resource.data.memberUids;

      // A new kitchen must be created owned by, and containing only, its
      // creator, and never pre-flagged as premium. Without this a client could
      // create a kitchen that already lists someone else as a member, or one
      // that has granted itself a paid entitlement.
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == uid()
                    && request.resource.data.memberUids == [uid()]
                    && request.resource.data.get('isPremium', false) == false;

      // Only the owner changes membership. Ownership and the premium flag are
      // both immutable from a client — otherwise a member could promote
      // themselves and lock the owner out, or anyone could unlock a family plan.
      allow update: if isOwnerOf(kitchenId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.get('isPremium', false)
                       == resource.data.get('isPremium', false)
                    && uid() in request.resource.data.memberUids
                    && request.resource.data.memberUids.size()
                       <= memberLimitFor(kitchenIsPremium(kitchenId));

      allow delete: if isOwnerOf(kitchenId);

      // ─── Items ────────────────────────────────────────────────────────────
      match /items/{itemId} {

        // Reads stay open to members regardless of plan. If a subscription
        // lapses the user can still read back and export what they already
        // uploaded — their data is not held hostage. Only further backup stops.
        allow get: if isMemberOf(kitchenId);
        allow list: if isMemberOf(kitchenId);

        // Writing to the cloud is the premium feature. Free accounts are fully
        // functional offline; nothing is capped locally.
        //
        // Shape checks, because a malformed row is worse than a refused one
        // once several devices are reconciling:
        //   serverUpdatedAt is the pull cursor and must be the server's clock.
        //   lastOperationId names the operation that produced this state, so
        //   a device can recognise its own write coming back on pull.
        //   updatedAt is the device's own clock, kept for display.
        //   expiryDate is an ISO calendar date string, never a number. Rejecting
        //   a numeric timestamp here stops a client that still thinks in epoch
        //   millis from writing dates that every other client would misread.
        allow create, update: if isMemberOf(kitchenId)
                              && kitchenIsPremium(kitchenId)
                              && stampedByServer()
                              && request.resource.data.lastOperationId is string
                              && request.resource.data.updatedAt is number
                              && request.resource.data.expiryDate is string;

        // Everyday deletion is soft: the client sets isDeleted so the removal
        // can propagate to other devices. A hard delete would vanish without
        // ever reaching them.
        //
        // The owner is nonetheless allowed to hard-delete, because account
        // deletion has to actually erase the data. Firestore does not cascade
        // into subcollections, so deleting the kitchen alone would leave every
        // item orphaned in the database forever — which is precisely the
        // retention failure the deletion requirement exists to prevent. With no
        // Cloud Function available, the client must do it.
        //
        // Members cannot hard-delete: for them, soft delete remains the only
        // route, so a shared kitchen cannot be quietly emptied.
        allow delete: if isOwnerOf(kitchenId);
      }

      // ─── Events ───────────────────────────────────────────────────────────
      //
      // The ledger. Append-only is the whole point of it: impact and history
      // are read from these documents, so if a client could edit or remove one
      // it could rewrite what a household was told it did. There is deliberately
      // no update rule at all.
      match /events/{eventId} {

        allow get: if isMemberOf(kitchenId);
        allow list: if isMemberOf(kitchenId);

        // An event must name its actor honestly. Without this check a member
        // could append events attributed to someone else in the household.
        //
        // The document id is the operation id. That, with the absence of any
        // update rule, is what makes a push idempotent: a retried write of the
        // same operation lands on the same document, is an update, and is
        // refused — so a replayed sync can never double count a use.
        allow create: if isMemberOf(kitchenId)
                      && kitchenIsPremium(kitchenId)
                      && request.resource.data.actorUid == uid()
                      && request.resource.data.occurredAt is number
                      && request.resource.data.operationId is string
                      && request.resource.data.operationId == eventId
                      && stampedByServer();

        // No update, ever. Not even for the owner.

        // Deletion exists only so account erasure can complete, for the same
        // subcollection-cascade reason as items.
        allow delete: if isOwnerOf(kitchenId);
      }
    }
  }
}
