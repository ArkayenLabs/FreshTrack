# ==========================================
# ANDROID / KOTLIN PROJECT GITIGNORE (FRESHTRACK)
# ==========================================

# === Gradle ===
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
/local.properties
.gradle_app.setting
gradle-app.setting

# === IntelliJ / Android Studio ===
*.iml
.idea/
!.idea/codeStyles
!.idea/runConfigurations

# === VS Code ===
.vscode/

# === Kotlin / KSP Generated ===
# Ignore generated code, but keep Room schemas
app/build/
app/build/generated/
!app/schemas/**

# === Room / Database Schemas ===
# Keep JSON schema exports for future migrations
!app/schemas/
!app/schemas/**/*.json

# === Native Build Folders ===
.externalNativeBuild/
.cxx/

# === OS / Temporary Files ===
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak

# === Captures / Profiling ===
captures/
outputs/

# === JetBrains Kotlin Cache ===
.kotlin/
out/

# === Firebase ===
# Contains the project's Firebase config and API key. Kept out of the repo by
# choice — a fresh clone or CI build must supply its own copy.
google-services.json

# === Graphify (tool output, not source) ===
graphify-out/
run_graphify.ps1
# Registers graphify's PreToolUse hooks by absolute path to this machine's
# interpreter, so it cannot be shared. Each developer runs `graphify claude
# install` themselves; the committed CLAUDE.md section is the shared part.
.claude/settings.local.json

# === Node (Firestore rules tests only, not the Android build) ===
node_modules/
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/

# === Misc ===
*.apk
*.aab
mapping.txt

# ==========================================
# SECRETS — THIS REPOSITORY IS PUBLIC
# ==========================================
# Nothing below has ever been committed (history checked in full, 26 Sep
# 2026: 160 commits, no key-shaped string anywhere). The rules exist so that
# it stays that way. If a file has to live in the working tree to build or
# deploy, it belongs here, not in a commit.
#
# What is deliberately kept out and where it comes from instead:
#   google-services.json  Firebase config — a fresh clone supplies its own
#   keystore.properties   store/key passwords, read by app/build.gradle.kts
#   upload-keystore.jks   the upload signing key; losing it loses the app
#   local.properties      the SDK path, which is machine-specific
#   functions secrets     Firebase `defineSecret`, set with
#                         `firebase functions:secrets:set`, never in a file
#
# Signing keys and certificates
*.keystore
*.jks
*.p8
*.p12
*.pfx
*.pem
*.cer
*.crt
*.der
*.key
keystore.properties
upload-keystore*

# Service accounts and environment files
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
.env
.env.*
!.env.example
secrets.properties

# Store assets: large, regenerable, and not the app. The listing *text* is
# tracked at docs/store-listing.md.
playstore-listing-ss/
